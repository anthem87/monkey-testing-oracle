{
  "name": "form-skeleton",
  "version": "1.0.0",
  "description": "Full-stack TypeScript form with dynamic generation and validation - Base skeleton without oracle",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx src/backend/server.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "tsc && vite build",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build": "npm run build:frontend && npm run build:backend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "playwright:install": "playwright install --with-deps",
    "lint": "eslint src --ext ts,tsx",
  "preview": "vite preview",
  "evolution:demo": "tsx core/main.ts --config ./config/evolution.json",
    "analyze": "tsx core/main.ts --target-file",
    "test:smoke": "ts-node core/test-smoke.ts",
  "coverage:demo": "c8 --reporter=text --reporter=lcov ts-node core/main.ts --config ./config/evolution.json"
  },
  "keywords": [
    "typescript",
    "react",
    "express",
    "form",
    "validation",
    "playwright",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "c8": "^9.0.0"
  }
}
